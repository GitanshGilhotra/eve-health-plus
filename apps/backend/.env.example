# MongoDB Connection Strings
# Option 1: MongoDB Atlas Free Cloud Tier (Recommended)
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eve_health?retryWrites=true&w=majority"
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eve_health?retryWrites=true&w=majority"

# Option 2: Local MongoDB Community / Docker
DATABASE_URL="mongodb://localhost:27017/eve_health?replicaSet=rs0&directConnection=true"
MONGODB_URI="mongodb://localhost:27017/eve_health"

# Redis Cache & Concurrency Lock
# Cloud option: rediss://default:<password>@xxxx.upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Security & JWT Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="supersecretjwtkey_for_development_only_evehealth_2026"
REFRESH_SECRET="supersecretrefreshkey_for_development_only_evehealth_2026"

# Server Port
PORT=4000

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com/ -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_evehealth_key"
RAZORPAY_KEY_SECRET="dev_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="whsec_evehealth_test_secret"
